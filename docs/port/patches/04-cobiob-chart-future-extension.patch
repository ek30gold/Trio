+                    let amountCOB = Int(entry.cobProjectionValue.value?.doubleValue ?? 0)
+
+                    LineMark(x: .value("Time", projectedDate), y: .value("Value", amountCOB))
+                        .foregroundStyle(by: .value("Type", "COB"))
